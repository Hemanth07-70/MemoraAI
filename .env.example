# ─── Required ───────────────────────────────────────────────────────────────
# NVIDIA Nemotron LLM — get a free key at https://build.nvidia.com
NEMOTRON_API_KEY=nvapi-your-key-here

# ─── Optional overrides (defaults work fine for local Docker) ────────────────
# LLM_PROVIDER=nemotron          # nemotron | ollama
# OLLAMA_URL=http://ollama:11434  # only used when LLM_PROVIDER=ollama
# AI_HALLUCINATION_THRESHOLD=0.30
