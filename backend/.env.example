# Backend Environment Variables (Spring Boot)
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:postgresql://<NEON_DB_URL>?sslmode=require
SPRING_DATASOURCE_USERNAME=<NEON_USERNAME>
SPRING_DATASOURCE_PASSWORD=<NEON_PASSWORD>
JWT_SECRET=your_super_secret_key_that_is_at_least_32_bytes_long
JWT_EXPIRATION=86400000
AI_SERVICE_URL=https://memoraai-ai-service.onrender.com
CORS_ALLOWED_ORIGINS=https://memoraai.vercel.app,http://localhost:5173
NEMOTRON_API_KEY=nvapi-your-key-here
